---
import { site } from '../data/site';
import '../styles/global.css';

const shelfMarkup = site.works;
// Temporary faithful crop from the owner-supplied screenshot; replace with a true cutout later.
const portraitSrc = '/images/isaac-portrait.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <meta name="description" content="Isaac Ndahura — a personal corner of the internet." />
    <meta name="robots" content="noindex,nofollow" />
    <title>Isaac Ndahura — Personal archive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Oswald:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="topbar" data-animate="enter">
        <a class="wordmark" href="#top" aria-label="Isaac Ndahura home">IN<span>.</span></a>
        <nav class="nav" aria-label="Main navigation">
          {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="header-note">PERSONAL ARCHIVE</span>
        <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><span></span><span></span></button>
      </header>
      <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
        <div class="mobile-menu-head"><span class="wordmark" aria-hidden="true">IN<span>.</span></span><button class="menu-close" type="button" data-menu-close aria-label="Close menu">×</button></div>
        <nav class="mobile-nav" aria-label="Mobile navigation">{site.navigation.map((item, index) => <a href={item.href}><small>{String(index + 1).padStart(2, '0')}</small><span>{item.label}</span></a>)}</nav>
        <p class="mobile-menu-signoff mono">PERSONAL ARCHIVE · NAIROBI</p>
      </div>
      <main id="main">
        <div class:list={['intro-sequence', { 'has-portrait': Boolean(portraitSrc) }]}>
        <section class="hero" id="top" aria-labelledby="hero-title">
          <h1 id="hero-title" class="hero-title" data-animate="hero-title" aria-label="Isaac Ndahura"><span>Isaac</span> <span>Ndahura</span></h1>
          <p class="hero-intro">Curious about people, ideas, and making things that feel useful. This is where a few of those threads meet.</p>
        </section>
        {portraitSrc && <aside class="portrait-rail"><div class="portrait-note">this is me<svg viewBox="0 0 100 70" aria-hidden="true"><path d="M8 7 C68 0 87 26 62 56 M49 47 L62 58 L74 43" /></svg></div><img class="personal-cutout" src={portraitSrc} alt="Isaac Ndahura smiling" width="800" height="782" /></aside>}
        <section class="currently section" id="now" aria-label="About me"><p class="now-copy">Right now, I’m building <em>useful things</em>, learning from the people around me, and following the questions that refuse to leave me alone.</p><svg class="about-badge" aria-hidden="true" viewBox="0 0 120 120"><path d="M60 5 70 38 98 18 82 48 115 60 82 70 100 102 70 83 60 115 49 82 18 101 38 71 5 60 38 49 18 18 49 38Z" /></svg></section>
        </div>
        <section class="fragments section" id="story" aria-labelledby="story-title">
          <div class="section-topline"><div class="section-kicker mono"><span>03</span><span>A LIFE, IN FRAGMENTS</span></div><p class="section-aside">Choose a piece to bring it forward.</p></div>
          <div class="section-title-row"><h2 id="story-title" class="section-heading condensed">Bits &amp; Pieces</h2></div>
          <div class="fragment-experience" data-fragment-experience data-state="resting">
            <div class="fragment-stage" data-fragment-stage aria-label="Interactive collage of six replaceable archive artifacts">
              {site.fragments.map((fragment) => (
                <button
                  class:list={['fragment-card', `fragment-${fragment.layout}`]}
                  type="button"
                  data-fragment-card
                  data-fragment-id={fragment.id}
                  data-fragment-title={fragment.title}
                  data-fragment-description={fragment.description}
                  data-fragment-story={fragment.story}
                  data-fragment-meta={`${fragment.category} · ${fragment.date}`}
                  aria-expanded="false"
                  aria-controls="fragment-story-panel"
                  style={`--fragment-x:${fragment.position.x}%;--fragment-y:${fragment.position.y}%;--fragment-width:${fragment.position.width}%;--fragment-rotate:${fragment.position.rotate}deg`}
                >
                  <span class="fragment-art" data-kind={fragment.kind} aria-hidden="true">
                    {fragment.kind === 'photo' && <span class="artifact-photo"><i></i><b></b></span>}
                    {fragment.kind === 'note' && <span class="artifact-note">Keep the line<br/>that still feels<br/>true.</span>}
                    {fragment.kind === 'sketch' && <span class="artifact-sketch"><i></i><b></b><em></em></span>}
                    {fragment.kind === 'journal' && <span class="artifact-journal"><i></i><b></b></span>}
                    {fragment.kind === 'screenshot' && <span class="artifact-screen"><i></i><b></b><em></em></span>}
                  </span>
                  <span class="fragment-caption"><span>{fragment.label}</span><small>{fragment.id} · {fragment.category}</small></span>
                </button>
              ))}
            </div>
            <aside class="fragment-story-panel" id="fragment-story-panel" data-fragment-panel aria-live="polite" aria-hidden="true">
              <button class="fragment-close" type="button" data-fragment-close aria-label="Close artifact story">×</button>
              <p class="fragment-panel-meta mono" data-fragment-meta>Select a piece</p>
              <h3 data-fragment-title>Bits from the archive</h3>
              <p data-fragment-description>Six provisional objects hold the shape of this section until the real artifacts arrive.</p>
              <p class="fragment-panel-story" data-fragment-story>The formats and interactions are real; the personal content is intentionally replaceable.</p>
            </aside>
          </div>
        </section>
        <section class="library section" id="work" aria-labelledby="work-title">
          <div class="section-topline"><div class="section-kicker mono"><span>04</span><span>THINGS I’VE MADE</span></div><p class="section-aside">A physical shelf, not a reading list.</p></div>
          <div class="section-title-row"><h2 id="work-title" class="section-heading condensed">The Bookshelf</h2></div>

          <div class="shelf-stage" data-shelf aria-label="Interactive bookshelf simulation. Seven placeholders, not actual projects.">
            <div class="shelf-platform" data-shelf-row="1" aria-label="Upper shelf"></div>
            <div class="shelf-platform shelf-platform-lower" data-shelf-row="2" aria-label="Lower shelf"></div>
            <div class="shelf-books" role="list">{shelfMarkup.map((book) => <div class="book-body" role="listitem" data-book data-tone={book.tone} data-row={book.id <= '04' ? 'upper' : 'lower'} data-id={book.id} tabindex="0" aria-label={`${book.title}, review placeholder, activate or use arrow keys to adjust`} data-preview-slug={book.slug} data-preview-title={book.title} data-preview-summary={book.summary}><span class="book-spine" aria-hidden="true"><span>{book.title}</span></span></div>)}</div>
            <noscript><p class="noscript-note">The shelf remains a static, labelled visual without JavaScript.</p></noscript>
          </div>
          <dialog class="work-preview" data-work-preview aria-labelledby="work-preview-title"><button class="preview-close" type="button" data-preview-close aria-label="Close project preview">×</button><div class="open-book"><div class="open-book-page preview-cover" data-preview-cover aria-hidden="true"></div><div class="open-book-page preview-copy"><span class="preview-index mono" data-preview-index></span><h3 id="work-preview-title" data-preview-title></h3><p data-preview-summary></p><a class="text-button" data-preview-link href="/projects/first-project/">Read more</a></div></div></dialog>
        </section>
        <section class="thoughts section" id="thoughts" aria-labelledby="thoughts-title"><div class="section-topline"><div class="section-kicker mono"><span>05</span><span>NOTES FROM THE INSIDE</span></div><p class="section-aside">Notes, questions, and ideas.</p></div><div class="section-title-row"><h2 id="thoughts-title" class="section-heading condensed">From My Head</h2></div><div class="writing-row" tabindex="0" aria-label="Horizontally browsable writing placeholder cards">{site.notes.map((note, index) => <article class="writing-card" data-writing-card><a href={`/articles/${note.slug}/`}><div class:list={['writing-art', `writing-art-${index + 1}`]} aria-hidden="true"><i></i></div><div class="writing-meta mono">{note.id}</div><h3>{note.title}</h3><p>{note.excerpt}</p><span class="card-read">Read note →</span></a></article>)}</div></section>
        <section class="closing section" id="hello" aria-labelledby="hello-title"><div class="section-kicker mono"><span>06</span><span>A SMALL INVITATION</span></div><h2 id="hello-title" class="closing-title">Something on your mind?</h2><p class="closing-copy">Leave the thought here. Sending opens your email app with the note already composed.</p><form class="note-form" data-note-form><div class="note-field"><label for="note-name">Name <span>optional</span></label><input id="note-name" name="name" autocomplete="name" /></div><div class="note-field"><label for="note-email">Email <span>optional</span></label><input id="note-email" name="email" type="email" autocomplete="email" /></div><div class="note-field note-message"><label for="note-message">Your note</label><textarea id="note-message" name="message" rows="5" required></textarea></div><button class="note-submit" type="submit">Open in my email app <span aria-hidden="true">↗</span></button><p class="note-status" data-note-status aria-live="polite"></p></form><div class="closing-mark" aria-hidden="true">IN<span>.</span></div></section>
      </main>
      <footer class="footer mono"><span>MADE SLOWLY, WITH CURIOSITY.</span><span>NAIROBI · © 2026</span></footer>
    </div>
    <script>import '../scripts/main.js';</script>
  </body>
</html>
